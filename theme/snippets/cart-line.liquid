{%- comment -%} Usage: {% render 'cart-line', item: item, index: forloop.index %} {%- endcomment -%}
<div class="cart-line" data-line="{{ index }}" data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="media ratio-tall" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
    {%- endif -%}
  </a>
  <div>
    <div class="cart-line__top">
      <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
      <span class="price">{{ item.final_line_price | money }}</span>
    </div>
    <div class="cart-line__opts">
      {%- unless item.product.has_only_default_variant -%}
        {%- for option in item.options_with_values -%}
          <div>{{ option.name }}: {{ option.value }}</div>
        {%- endfor -%}
      {%- endunless -%}
      {%- for p in item.properties -%}
        {%- if p.first == '_set' and p.last != blank -%}<div>Part of: {{ p.last }}</div>{%- endif -%}
      {%- endfor -%}
      {%- if item.quantity > 1 -%}<div>{{ item.final_price | money }} each</div>{%- endif -%}
      {%- if item.selling_plan_allocation -%}<div>{{ item.selling_plan_allocation.selling_plan.name }}</div>{%- endif -%}
    </div>
    <div class="cart-line__bottom">
      <div class="qty">
        <button type="button" data-qty-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
        <label class="visually-hidden" for="Qty-{{ index }}">Quantity of {{ item.product.title | escape }}</label>
        <input id="Qty-{{ index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-qty-input>
        <button type="button" data-qty-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
      </div>
      <a class="remove-btn" href="{{ item.url_to_remove }}" data-remove>Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></a>
    </div>
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="xsmall muted">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
    {%- endfor -%}
  </div>
</div>
