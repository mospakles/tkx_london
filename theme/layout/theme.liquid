<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign heading_bold = heading_font | font_modify: 'weight', 'bolder'
      assign body_font = settings.type_body_font
      assign body_bold = body_font | font_modify: 'weight', 'bold'
    -%}
    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ heading_bold | font_face: font_display: 'swap' }}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_bold | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --c-ivory: {{ settings.color_background }};
        --c-paper: {{ settings.color_surface }};
        --c-black: {{ settings.color_text }};
        --c-charcoal: {{ settings.color_charcoal }};
        --c-chocolate: {{ settings.color_chocolate }};
        --c-taupe: {{ settings.color_taupe }};
        --c-olive: {{ settings.color_olive }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- unless heading_font.system? -%}
      {{ heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.TKX = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        currency: {{ cart.currency.iso_code | json }},
        locale: {{ request.locale.iso_code | split: '-' | first | append: '-' | append: localization.country.iso_code | json }},
        storeMode: {{ settings.store_mode | json }}
      };
    </script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- comment -%}
      Cookie banner. Off by default: Shopify's own cookie banner
      (Settings → Customer privacy) is recommended and is managed by Shopify.
      Turn this on only if the native banner is not used — never both.
    {%- endcomment -%}
    {%- if settings.cookie_banner_enabled -%}
      {% render 'cookie-banner' %}
    {%- endif -%}

    <div class="overlay" data-overlay hidden></div>
  </body>
</html>
