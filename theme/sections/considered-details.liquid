<section class="section" aria-labelledby="CD-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="h1" id="CD-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <ul class="details-grid" role="list">
      {%- for block in section.blocks -%}
        <li class="reveal" {{ block.shopify_attributes }}>
          <figure class="detail-card">
            <div class="media ratio-square zoom-on-hover">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw' }}
              {%- else -%}
                {% render 'placeholder', type: 'detailed-apparel-1', label: 'Close-up: fabric, seam, pocket or tonal branding' %}
              {%- endif -%}
            </div>
            <figcaption>
              <h3>{{ block.settings.heading | escape }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Considered details",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Up close" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered Details" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Close-up image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Detail" },
        { "type": "textarea", "id": "text", "label": "Description", "info": "Describe only verified features from the garment specification." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Considered details",
      "blocks": [
        { "type": "detail", "settings": { "heading": "Fabric", "text": "Add verified detail" } },
        { "type": "detail", "settings": { "heading": "Seams", "text": "Add verified detail" } },
        { "type": "detail", "settings": { "heading": "Pockets", "text": "Add verified detail" } },
        { "type": "detail", "settings": { "heading": "Tonal branding", "text": "Add verified detail" } }
      ]
    }
  ]
}
{% endschema %}
