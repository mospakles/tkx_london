{%- if section.blocks.size > 0 -%}
<section class="section color-scheme-paper" aria-labelledby="STL-{{ section.id }}">
  <div class="page-width">
    <div class="section__head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="h1" id="STL-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<p class="lede muted">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="look__tabs" role="tablist" aria-label="Looks">
        {%- for block in section.blocks -%}
          <button type="button" role="tab" id="LookTab-{{ block.id }}" aria-controls="LookPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {% unless forloop.first %}tabindex="-1"{% endunless %}>
            {{ block.settings.name | escape }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <look-bundle class="look" id="LookPanel-{{ block.id }}" {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="LookTab-{{ block.id }}"{% endif %} {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
        <div class="media ratio-portrait">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 52vw, 100vw' }}
          {%- else -%}
            {% render 'placeholder', type: 'lifestyle-2', label: 'Look image — full outfit, head to toe' %}
          {%- endif -%}
        </div>
        <div>
          <h3 class="h2" style="margin-bottom: 20px">{{ block.settings.name | escape }}</h3>
          {%- liquid
            assign count = 0
          -%}
          {%- for i in (1..4) -%}
            {%- liquid
              assign key = 'product_' | append: i
              assign ckey = 'colour_' | append: i
              assign p = block.settings[key]
              assign uid = block.id | append: '-' | append: i
            -%}
            {%- if p != blank -%}
              {%- assign count = count | plus: 1 -%}
              {% render 'component-picker', product: p, colour: block.settings[ckey], uid: uid, optional: true %}
            {%- endif -%}
          {%- endfor -%}

          {%- if count == 0 -%}
            {% render 'owner-review', note: 'Choose up to four products for this look.' %}
          {%- else -%}
            <div class="look__total">
              <span>Total for selected pieces</span>
              <strong data-bundle-total aria-live="polite">{{ 0 | money }}</strong>
            </div>
            {%- if settings.store_mode == 'live' -%}
              <button type="button" class="btn btn--block" data-bundle-add disabled>Choose sizes to add</button>
            {%- else -%}
              {% render 'primary-cta', class: 'btn btn--block' %}
            {%- endif -%}
            <div class="status-msg" data-bundle-status role="status" hidden></div>
          {%- endif -%}
        </div>
      </look-bundle>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop the look",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Coordinated outfits" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Look" },
    { "type": "text", "id": "text", "label": "Intro", "default": "Choose a size for each piece. Untick anything you don't need." }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "text", "id": "name", "label": "Look name", "default": "Desk to studio" },
        { "type": "image_picker", "id": "image", "label": "Outfit image" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "text", "id": "colour_1", "label": "Product 1 colour", "info": "Exact colour name as in the product (optional)." },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "text", "id": "colour_2", "label": "Product 2 colour" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "text", "id": "colour_3", "label": "Product 3 colour" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "text", "id": "colour_4", "label": "Product 4 colour" }
      ]
    }
  ],
  "presets": [{ "name": "Shop the look", "blocks": [{ "type": "look" }] }]
}
{% endschema %}
