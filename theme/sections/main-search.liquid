<div class="page-width">
  <header class="page-hero">
    <h1 class="h1">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="mt-32" style="max-width:640px">
      <div class="search-field">
        <label class="visually-hidden" for="SearchPageInput">Search the shop</label>
        <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products" autocomplete="off">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="icon-btn">{% render 'icon', name: 'search' %}<span class="visually-hidden">Search</span></button>
      </div>
    </form>
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="small muted" role="status">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <h2 class="h3">Nothing found</h2>
          <p>Check the spelling or try a broader term like “legging” or “set”.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a>
        </div>
      {%- else -%}
        <ul class="product-grid product-grid--4 mt-32" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{% render 'product-card', product: item, lazy: true %}</li>
            {%- else -%}
              <li class="stack-8">
                <a class="product-card__title" href="{{ item.url }}">{{ item.title | escape }}</a>
                <p class="small muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination mt-32" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="btn btn--secondary" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
            <span class="small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="btn btn--secondary" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
  <div class="section--tight"></div>
</div>

{% schema %}
{ "name": "Search results" }
{% endschema %}
