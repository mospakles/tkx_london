<section class="section {{ section.settings.scheme }}" aria-labelledby="ST-{{ section.id }}">
  <div class="page-width story">
    <div class="media ratio-portrait">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        {% render 'placeholder', type: 'lifestyle-1', label: 'Brand story image' %}
      {%- endif -%}
    </div>
    <div class="story__text">
      {%- if section.settings.show_emblem and settings.emblem != blank -%}
        {{ settings.emblem | image_url: width: 120 | image_tag: class: 'emblem-mark', loading: 'lazy', alt: '' }}
      {%- endif -%}
      <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h2 class="h1" id="ST-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.link != blank -%}
        <p><a class="link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "show_emblem", "label": "Show emblem", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the whole day" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>TKX London designs clothing for days that don't stay in one place — from the commute and the desk to the studio, the weekend and everything in between.</p><p>We bring elegant everyday comfort together with sporty, streetwear-led shapes: considered pieces that are easy to wear and confident to be seen in.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "", "label": "Ivory" },
        { "value": "color-scheme-paper", "label": "Paper" },
        { "value": "color-scheme-chocolate", "label": "Chocolate" },
        { "value": "color-scheme-dark", "label": "Black" }
      ],
      "default": "color-scheme-chocolate"
    }
  ],
  "presets": [{ "name": "Our story" }]
}
{% endschema %}
