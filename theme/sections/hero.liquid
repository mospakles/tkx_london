{%- comment -%}
  Campaign hero. Keep models' full silhouettes visible: choose a focal point
  in the image picker, and use a portrait mobile image where possible.
{%- endcomment -%}
<section class="hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <hero-video>
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
        <button type="button" class="icon-btn hero__video-toggle" data-video-toggle aria-pressed="false">
          <span data-icon-pause>{% render 'icon', name: 'pause' %}</span>
          <span data-icon-play hidden>{% render 'icon', name: 'play' %}</span>
          <span class="visually-hidden">Pause background video</span>
        </button>
      </hero-video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- endif -%}
        {%- assign hero_alt = section.settings.image.alt | default: section.settings.image_alt -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', alt: hero_alt }}
      </picture>
    {%- else -%}
      {% render 'placeholder', type: 'lifestyle-1', label: 'Campaign hero — women wearing the collection, full-length silhouettes visible' %}
    {%- endif -%}
    <div class="hero__scrim"></div>
  </div>
  <div class="hero__content page-width">
    <div class="stack-16">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="h-display hero__title" id="HeroTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
    </div>
    <div class="hero__aside">
      {%- if section.settings.subheading != blank -%}<p class="hero__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      <div class="hero__ctas">
        {% render 'primary-cta', class: 'btn btn--light' %}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a class="btn btn--secondary" style="--fg: var(--c-paper); --bg: var(--c-black)" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Landscape, at least 2400px wide. Set the focal point so full silhouettes stay visible." },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile)", "info": "Portrait crop for phones." },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)" },
    { "type": "video", "id": "video", "label": "Short muted video (optional)", "info": "Replaces the image. Keep it short; it plays muted and can be paused." },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "EVERYDAY IN MOTION." },
    { "type": "text", "id": "subheading", "label": "Supporting line", "default": "Considered comfort. Confident style." },
    { "type": "paragraph", "content": "The main button follows Theme settings → Store mode (Join the Launch List / Shop the Collection)." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Campaign hero" }]
}
{% endschema %}
