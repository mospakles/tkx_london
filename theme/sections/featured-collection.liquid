{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
{%- if collection != blank and collection.products_count > 0 -%}
  <section class="section" aria-labelledby="FC-{{ section.id }}">
    <div class="page-width">
      <div class="section__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          <h2 class="h1" id="FC-{{ section.id }}">{{ section.settings.heading | default: collection.title | escape }}</h2>
        </div>
        {%- if settings.store_mode == 'live' -%}
          <a class="link-arrow" href="{{ collection.url }}">View all<span class="visually-hidden"> {{ collection.title | escape }}</span></a>
        {%- endif -%}
      </div>
      <ul class="product-grid product-grid--4" role="list">
        {%- for product in collection.products limit: limit -%}
          <li class="reveal">{% render 'product-card', product: product, lazy: true %}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section"><div class="page-width">{% render 'owner-review', note: 'Choose a collection with products for the Launch collection section. Empty collections are hidden from customers.' %}</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Launch collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The first collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Launch Collection" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Launch collection" }]
}
{% endschema %}
