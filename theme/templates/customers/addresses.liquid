<div class="page-width" style="max-width:640px;padding-block:64px">
  <p><a href="{{ routes.account_url }}">← Account</a></p>
  <h1 class="h2 mt-16">Addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="mt-32">
        <p>{{ address | format_address }}{% if address == customer.default_address %}<br><strong>Default</strong>{% endif %}</p>
        <form method="post" action="{{ address.url }}" class="mt-16">
          <input type="hidden" name="_method" value="delete">
          <button class="remove-btn" onclick="return confirm('Delete this address?')">Delete<span class="visually-hidden"> address {{ forloop.index }}</span></button>
        </form>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <h2 class="h3 mt-32">Add a new address</h2>
  {%- form 'customer_address', customer.new_address, class: 'mt-16' -%}
    {%- if form.errors -%}<p class="status-msg status-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field"><label for="AddrFirst">First name</label><input class="input" id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
    <div class="field"><label for="AddrLast">Last name</label><input class="input" id="AddrLast" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
    <div class="field"><label for="Addr1">Address</label><input class="input" id="Addr1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
    <div class="field"><label for="Addr2">Address line 2</label><input class="input" id="Addr2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
    <div class="field"><label for="AddrCity">City</label><input class="input" id="AddrCity" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
    <div class="field"><label for="AddrCountry">Country</label><select class="select" id="AddrCountry" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></div>
    <div class="field"><label for="AddrZip">Postcode</label><input class="input" id="AddrZip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
    <div class="field"><label for="AddrPhone">Phone</label><input class="input" id="AddrPhone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
    <label class="checkbox">{{ form.set_as_default_checkbox }} Set as default</label>
    <button class="btn mt-16">Add address</button>
  {%- endform -%}
</div>
