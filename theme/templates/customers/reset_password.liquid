<div class="page-width" style="max-width:520px;padding-block:64px">
  <h1 class="h2">Reset password</h1>
  {%- form 'reset_customer_password', class: 'mt-32' -%}
    {%- if form.errors -%}<p class="status-msg status-msg--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="field"><label for="ResetPassword">New password</label><input class="input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="ResetConfirm">Confirm password</label><input class="input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--block">Reset password</button>
  {%- endform -%}
</div>
